@page "/"
@inject IDemoDatasetStore DatasetStore

<PageTitle>Dashboard - ViteKlub</PageTitle>

<MudStack Spacing="3">
    <div>
        <h1 class="mud-typography mud-typography-h3">Dashboard</h1>
        <MudText Typo="Typo.body1" Color="Color.Secondary">
            Panoramica operativa della palestra ViteKlub.
        </MudText>
    </div>

    @if (_isLoading)
    {
        <MudProgressLinear Indeterminate="true" Color="Color.Primary" aria-label="Caricamento dataset" />
        <MudText role="status">Caricamento dei dati demo…</MudText>
    }
    else if (_errorMessage is not null)
    {
        <MudAlert Severity="Severity.Error" Variant="Variant.Outlined">
            @_errorMessage
        </MudAlert>
    }
    else if (_snapshot is not null)
    {
        <MudAlert Severity="Severity.Info" Variant="Variant.Outlined">
            Dataset @_snapshot.Dataset.DatasetVersion caricato: @_snapshot.Dataset.Members.Count iscritti.
            Persistenza: @StorageModeLabel.
        </MudAlert>

        <MudGrid>
        @foreach (var area in DemoEnvironment.FunctionalAreas.Skip(1))
        {
            <MudItem xs="12" sm="6" md="4">
                <MudPaper Class="pa-4" Outlined="true">
                    <MudText Typo="Typo.h6">@area</MudText>
                    <MudText Typo="Typo.body2">Funzionalità predisposta per i prossimi incrementi.</MudText>
                </MudPaper>
            </MudItem>
        }
        </MudGrid>
    }
</MudStack>

@code {
    private bool _isLoading = true;
    private DemoDatasetSnapshot? _snapshot;
    private string? _errorMessage;

    private string StorageModeLabel => _snapshot?.StorageMode == DemoStorageMode.IndexedDb
        ? "IndexedDB"
        : "memoria temporanea";

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _snapshot = await DatasetStore.LoadAsync();
        }
        catch (Exception)
        {
            _errorMessage = "Non è stato possibile caricare i dati demo. Ricarica la pagina per riprovare.";
        }
        finally
        {
            _isLoading = false;
        }
    }
}
