@page "/members/{Id:guid}"
@attribute [Authorize(Roles = DemoRoles.All)]
@inject IDemoDatasetStore DatasetStore
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject IDialogService DialogService
@inject NavigationManager NavigationManager
@inject ViteKlub.Web.Members.MemberCommandFactory CommandFactory

<PageTitle>Dettaglio iscritto - ViteKlub</PageTitle>

<MudStack Spacing="3">
    <MudButton Variant="Variant.Text" Href="members" StartIcon="@Icons.Material.Filled.ArrowBack">
        Torna agli iscritti
    </MudButton>

    @if (_isLoading)
    {
        <MudProgressLinear Indeterminate="true" Color="Color.Primary" aria-label="Caricamento dettaglio iscritto" />
        <MudText role="status">Caricamento del dettaglio…</MudText>
    }
    else if (_errorMessage is not null)
    {
        <MudAlert Severity="Severity.Error" Variant="Variant.Outlined" role="alert">@_errorMessage</MudAlert>
    }
    else if (_member is null)
    {
        <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined" role="alert">
            L’iscritto richiesto non esiste nel dataset demo.
        </MudAlert>
    }
    else
    {
        <div>
            <h1 class="mud-typography mud-typography-h3">@_member.FirstName @_member.LastName</h1>
            <MudText Color="Color.Secondary">Dati dell’iscritto demo memorizzati localmente.</MudText>
        </div>
        @if (_feedback is not null) { <MudAlert Severity="Severity.Success" role="status" aria-live="polite">@_feedback</MudAlert> }
        <AuthorizeView Roles="@DemoRoles.MemberManagement">
            <MudStack Row="true" Style="flex-wrap: wrap">
                @if (_member.Status != MemberStatus.Archived) { <MudButton Href="@($"members/{Id:D}/edit")" Disabled="_saving" aria-label="@($"Modifica {_member.FirstName} {_member.LastName}")">Modifica</MudButton> }
                @if (_member.Status == MemberStatus.Active) { <MudButton OnClick="@(() => ChangeStatusAsync(MemberStatus.Suspended))" Disabled="_saving" aria-label="@($"Sospendi {_member.FirstName} {_member.LastName}")">Sospendi</MudButton> }
                @if (_member.Status == MemberStatus.Suspended) { <MudButton OnClick="@(() => ChangeStatusAsync(MemberStatus.Active))" Disabled="_saving" aria-label="@($"Riattiva {_member.FirstName} {_member.LastName}")">Riattiva</MudButton> }
                @if (_member.Status is MemberStatus.Active or MemberStatus.Suspended) { <MudButton Color="Color.Error" OnClick="ArchiveAsync" Disabled="_saving" aria-label="@($"Archivia {_member.FirstName} {_member.LastName}")">Archivia</MudButton> }
            </MudStack>
        </AuthorizeView>
        @if (_saving) { <MudText role="status" aria-live="polite">Salvataggio in corso…</MudText> }
        <MudPaper Class="pa-4" Outlined="true">
            <MudGrid>
                <MudItem xs="12" sm="6"><MudText Typo="Typo.overline">Numero tessera</MudText><MudText>@_member.MemberNumber</MudText></MudItem>
                <MudItem xs="12" sm="6"><MudText Typo="Typo.overline">Stato</MudText><MudText>@MemberDirectory.MemberStatusLabel(_member.Status)</MudText></MudItem>
                <MudItem xs="12" sm="6"><MudText Typo="Typo.overline">Data di iscrizione</MudText><MudText>@FormatDate(_member.JoinedOn)</MudText></MudItem>
                <MudItem xs="12" sm="6"><MudText Typo="Typo.overline">Scadenza certificato medico</MudText><MudText>@FormatDate(_member.MedicalCertificateExpiresOn)</MudText></MudItem>
                <MudItem xs="12"><MudText Typo="Typo.overline">Stato certificato medico</MudText><MudAlert Severity="@CertificateSeverity" Variant="Variant.Outlined">@CertificateLabel</MudAlert></MudItem>
            </MudGrid>
        </MudPaper>
    }
</MudStack>

@code {
    [Parameter]
    public Guid Id { get; set; }

    private DateOnly _referenceDate;
    private Member? _member;
    private bool _isLoading = true;
    private string? _errorMessage;
    private DemoDataset? _dataset;
    private bool _saving;
    private string? _feedback;

    private MedicalCertificateState CertificateState => MemberDirectory.ClassifyCertificate(
        _member?.MedicalCertificateExpiresOn, _referenceDate);
    private string CertificateLabel => MemberDirectory.CertificateStateLabel(CertificateState);
    private Severity CertificateSeverity => CertificateState switch
    {
        MedicalCertificateState.Expired => Severity.Error,
        MedicalCertificateState.ExpiringSoon => Severity.Warning,
        MedicalCertificateState.Valid => Severity.Success,
        _ => Severity.Info
    };

    protected override async Task OnParametersSetAsync()
    {
        _isLoading = true;
        _errorMessage = null;
        try
        {
            DemoDatasetSnapshot snapshot = await DatasetStore.LoadAsync();
            _dataset = snapshot.Dataset;
            _referenceDate = snapshot.Dataset.ReferenceDate;
            _member = MemberDirectory.FindById(snapshot.Dataset.Members, Id);
            if (NavigationManager.Uri.Contains("saved=1", StringComparison.Ordinal)) _feedback = "Iscritto salvato correttamente.";
        }
        catch (Exception)
        {
            _errorMessage = "Non è stato possibile caricare il dettaglio. Ricarica la pagina per riprovare.";
        }
        finally
        {
            _isLoading = false;
        }
    }

    private static string FormatDate(DateOnly date) => date.ToString("dd/MM/yyyy", System.Globalization.CultureInfo.GetCultureInfo("it-IT"));
    private static string FormatDate(DateOnly? date) => date is null ? "Non presente" : FormatDate(date.Value);

    private async Task ArchiveAsync()
    {
        bool? confirmed = await DialogService.ShowMessageBox("Conferma archiviazione",
            $"Archiviare {_member!.FirstName} {_member.LastName}? L’iscritto resterà nello storico e non potrà essere riattivato.", yesText: "Archivia", cancelText: "Annulla");
        if (confirmed == true) await ChangeStatusAsync(MemberStatus.Archived);
    }

    private async Task ChangeStatusAsync(MemberStatus target)
    {
        if (_saving || _dataset is null || _member is null) return;
        _saving = true; _errorMessage = null;
        try
        {
            AuthenticationState state = await AuthenticationStateProvider.GetAuthenticationStateAsync();
            Guid actor = Guid.Parse(state.User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)!.Value);
            DemoDatasetSnapshot current = await DatasetStore.LoadAsync();
            MemberOperationResult operation = CommandFactory.ChangeStatus(
                current.Dataset, Id, _member.Version, target, actor);
            DemoDatasetSnapshot saved = await DatasetStore.SaveAsync(operation.Dataset, current.Revision);
            _dataset = saved.Dataset; _member = operation.Member;
            _feedback = target switch { MemberStatus.Active => "Iscritto riattivato.", MemberStatus.Suspended => "Iscritto sospeso.", _ => "Iscritto archiviato." };
        }
        catch (MemberValidationException exception) { _errorMessage = exception.Errors.Values.SelectMany(item => item).First(); }
        catch (DemoDatasetConflictException) { _errorMessage = "I dati sono cambiati. Ricarica la pagina e riprova."; }
        catch { _errorMessage = "Non è stato possibile completare l’operazione. I dati correnti non sono stati modificati."; }
        finally { _saving = false; }
    }
}
