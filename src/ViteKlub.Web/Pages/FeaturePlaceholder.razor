@page "/demo"
@attribute [Authorize]
@inject NavigationManager Navigation

<PageTitle>@Title - ViteKlub</PageTitle>

<h1 class="mud-typography mud-typography-h3">@Title</h1>
<MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Class="mt-4">
    Questa area verrà implementata in un prossimo incremento.
</MudAlert>

@code {
    [CascadingParameter]
    private Task<AuthenticationState> AuthenticationStateTask { get; set; } = default!;

    private const string Title = "Gestione demo";

    protected override async Task OnInitializedAsync()
    {
        AuthenticationState state = await AuthenticationStateTask;
        string path = Navigation.ToBaseRelativePath(Navigation.Uri);
        if (!DemoNavigation.IsAuthorized(path, state.User))
        {
            Navigation.NavigateTo($"access-denied?returnUrl={Uri.EscapeDataString('/' + path)}", replace: true);
        }
    }
}
