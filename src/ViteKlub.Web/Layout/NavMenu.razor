<MudNavMenu>
    <AuthorizeView Context="auth">
        @foreach (DemoNavigationItem item in DemoNavigation.Items.Where(item => item.IsAuthorized(auth.User)))
        {
            @if (item.StartsAdministrationSection)
            {
                <MudDivider Class="my-2" />
            }
            <MudNavLink Href="@item.Href" Match="@item.Match" Icon="@item.Icon">@item.Label</MudNavLink>
        }
    </AuthorizeView>
</MudNavMenu>
