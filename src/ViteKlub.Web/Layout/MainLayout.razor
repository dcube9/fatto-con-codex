@inherits LayoutComponentBase

<MudThemeProvider />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<MudLayout>
    <MudAppBar Elevation="1" Color="Color.Primary">
        <MudIconButton Icon="@Icons.Material.Filled.Menu" Color="Color.Inherit" Edge="Edge.Start"
                       OnClick="ToggleDrawer" aria-label="Apri o chiudi la navigazione" />
        <MudText Typo="Typo.h6">
            ViteKlub <span class="app-version">@ApplicationVersion.Display</span>
        </MudText>
        <MudSpacer />
        <MudChip T="string" Color="Color.Warning" Variant="Variant.Filled" Size="Size.Small">
            Ambiente demo
        </MudChip>
        <AuthorizeView>
            <Authorized Context="auth">
                <MudText Class="ml-3" Typo="Typo.body2">@auth.User.Identity?.Name</MudText>
                <MudIconButton Icon="@Icons.Material.Filled.Logout" Color="Color.Inherit"
                               OnClick="LogoutAsync" aria-label="Esci dalla sessione demo" />
            </Authorized>
        </AuthorizeView>
    </MudAppBar>

    <MudDrawer @bind-Open="_drawerOpen" Elevation="1" Variant="DrawerVariant.Responsive">
        <MudDrawerHeader>
            <MudText Typo="Typo.h6" Color="Color.Primary">ViteKlub</MudText>
        </MudDrawerHeader>
        <NavMenu />
    </MudDrawer>

    <MudMainContent>
        <MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="pa-6">
            @Body
        </MudContainer>
    </MudMainContent>
</MudLayout>

@code {
    [Inject]
    private IDemoAuthenticationService AuthenticationService { get; set; } = default!;

    [Inject]
    private NavigationManager Navigation { get; set; } = default!;

    private bool _drawerOpen = true;

    private void ToggleDrawer() => _drawerOpen = !_drawerOpen;

    private async Task LogoutAsync()
    {
        await AuthenticationService.LogoutAsync();
        Navigation.NavigateTo("login", replace: true);
    }
}
