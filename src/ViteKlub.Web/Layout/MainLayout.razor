@inherits LayoutComponentBase
@inject IDemoAuthenticationService Authentication
@inject NavigationManager Navigation

<MudThemeProvider />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<MudLayout>
    <MudAppBar Elevation="1" Color="Color.Primary">
        <MudIconButton Icon="@Icons.Material.Filled.Menu" Color="Color.Inherit" Edge="Edge.Start"
                       OnClick="ToggleDrawer" aria-label="Apri o chiudi la navigazione" />
        <MudText Typo="Typo.h6">ViteKlub</MudText>
        <MudSpacer />
        <AuthorizeView Context="authState">
            <Authorized>
                <MudText Typo="Typo.body2" Class="mr-3 user-name">@authState.User.Identity?.Name</MudText>
                <MudIconButton Icon="@Icons.Material.Filled.Logout" Color="Color.Inherit"
                               OnClick="LogoutAsync" aria-label="Esci dal profilo demo" />
            </Authorized>
        </AuthorizeView>
        <MudChip T="string" Color="Color.Warning" Variant="Variant.Filled" Size="Size.Small">
            Ambiente demo
        </MudChip>
    </MudAppBar>

    <MudDrawer @bind-Open="_drawerOpen" Elevation="1" Variant="DrawerVariant.Responsive">
        <MudDrawerHeader>
            <MudText Typo="Typo.h6" Color="Color.Primary">ViteKlub</MudText>
        </MudDrawerHeader>
        <NavMenu />
    </MudDrawer>

    <MudMainContent>
        <MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="pa-6">
            @Body
        </MudContainer>
    </MudMainContent>
</MudLayout>

@code {
    private bool _drawerOpen = true;

    private void ToggleDrawer() => _drawerOpen = !_drawerOpen;

    private async Task LogoutAsync()
    {
        await Authentication.LogoutAsync();
        Navigation.NavigateTo("login");
    }
}
